# Copia este archivo a .env.local y llena los valores.

# Postgres (Neon, Supabase, etc.)
DATABASE_URL=postgres://usuario:password@host:5432/base

# better-auth
BETTER_AUTH_SECRET=genera-uno-con-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (opcional en desarrollo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (correos)
RESEND_API_KEY=

# Upstash QStash (recordatorios)
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
