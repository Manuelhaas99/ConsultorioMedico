# Copia este archivo a .env.local y llena los valores.
# Se validan con zod en lib/env.ts al primer uso de cada integración (no en el build).
# Un valor vacío cuenta como ausente.

# Postgres (Neon, Supabase, etc.)
# El certificado TLS del servidor siempre se verifica (ver lib/db/ssl.ts).
# - Neon: usa la URL que da el panel (trae ?sslmode=require); su certificado es de una CA pública.
# - Supabase: descarga el certificado CA (Project Settings > Database > SSL) y pégalo en DATABASE_CA_CERT.
# sslmode=no-verify no está permitido.
DATABASE_URL=postgres://usuario:password@host:5432/base?sslmode=verify-full
# Certificado CA del proveedor en PEM (opcional; los saltos de línea pueden ir como \n).
DATABASE_CA_CERT=
# Solo para un Postgres local o de CI sin SSL: descomenta para conectarte sin TLS.
# DATABASE_SSL=disable

# better-auth (secreto de al menos 32 caracteres; la URL pública también se usa en correos y webhooks)
BETTER_AUTH_SECRET=genera-uno-con-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (opcional: se habilita solo si están las dos)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (correos)
RESEND_API_KEY=

# Upstash QStash (recordatorios)
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
